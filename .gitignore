# RAG Pro Max - 出厂标准版 .gitignore
# 版本: v5.5.8 (Data Sovereignty Edition)
# 原则: 非必要不推送 - 本地保留所有数据，远程只推送核心代码

# ===== 运行时数据 (本地保留，远程忽略) =====
# 向量数据库存储 - 用户知识库数据
vector_db_storage/*
!vector_db_storage/.gitkeep

# 聊天历史记录 - 用户对话数据
chat_histories/*
!chat_histories/.gitkeep

# 临时上传与爬取文件 (强制忽略所有变体)
temp_uploads/
temp_uploads/*
batch_*
Web_*
Search_*
crawler_state_*.json

# 知识库导出全量包 (v5.5.8 新增)
ULTIMATE_BACKUP_*.zip
*.zip
*.7z
*.rar

# 用户数据目录 (用户生成的内容)
rag/
rag/*
text_*

# 应用日志 - 运行日志
app_logs/*
!app_logs/.gitkeep
*.log
*.jsonl

# ===== 测试和调试产物 (不推送) =====
ocr_debug/
temp_test_output/
*_test_*.txt
*_test_*.json
tests/test_kb/

# ===== 配置运行时文件 =====
# 应用运行时配置 (包含用户敏感/个性化数据)
config/app_config.json
config/alert_history.json
config/scheduler_history.json
config/monitoring_history.json
config/performance_history.json
config/rag_config.json
rag_config.json

# ===== 系统文件 =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# HuggingFace 模型缓存
hf_cache/*
!hf_cache/.gitkeep

# 建议历史与配置
suggestion_history/*
!suggestion_history/.gitkeep
suggestion_config/*
!suggestion_config/.gitkeep

# ===== Python 相关 =====
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# ===== 开发备份与过时文档 =====
*_backup.py
*_old.py
*.bak
*.tmp
PROJECT_STRUCTURE_*.md
PHASE_*.md
REFACTOR_PLAN.md
scratchpad.txt

# ===== 环境变量 =====
.env
.env*
! .env.example

# ===== 文档处理临时文件 =====
~$*.docx
~$*.xlsx
~$*.pptx

# ===== 本地资产与备份 (v5.6.0+ 非必要不推送) =====
aliyun_adb_docs_*/
aliyun_adb_mysql_docs_*/
.gemini_backup/
monitoring_alerts/
config/sessions.json
config/users.json
config/kb_sharing.json
temp_uploads/
